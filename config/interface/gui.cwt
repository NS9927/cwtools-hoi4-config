types = {
    ## type_key_filter = containerWindowType
    type[containerWindowType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = guiTypes
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = buttonType
    type[buttonType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = dropDownBoxType
    type[dropDownBoxType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = iconType
    type[iconType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }

        images = {
            subtype[!hidden] = {
                icon = spriteType
            }
        }
    }
    ## type_key_filter = instantTextBoxType
    type[instantTextBoxType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }

        localisation = {
            subtype[!hidden] = {
                text = text
                tooltip = pdx_tooltip
            }
        }
    }
    ## type_key_filter = OverlappingElementsBoxType
    type[OverlappingElementsBoxType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = gridBoxType
    type[gridBoxType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = listBoxType
    type[listBoxType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = smoothListBoxType
    type[smoothListBoxType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = positionType
    type[positionType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = browserType
    type[browserType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = editBoxType
    type[editBoxType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = checkboxType
    type[checkboxType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = scrollbarType
    type[scrollbarType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
    ## type_key_filter = extendedScrollbarType
    type[extendedScrollbarType] = {
        path = "game/interface"
        name_field = "name"
        path_extension = .gui
        skip_root_key = { guiTypes containerWindowType }
        skip_root_key = { guiTypes containerWindowType containerWindowType }
    }
}

containerWindowType = {
    name = scalar
    ### Origin of position field
    ## cardinality = 0..1
    orientation = enum[containerOrientation]
    ### Will remove elements outside of size bounding box
    ## cardinality = 0..1
    clipping = bool
    ## cardinality = 0..1
    fullscreen = bool
    ### Background texture
    ## cardinality = 0..inf
    background = {
        ## cardinality = 0..1
        name = scalar
        alias_name[gui_standard] = alias_match_left[gui_standard]
        alias_name[gui_image] = alias_match_left[gui_image]
        ## cardinality = 0..1
        alias_name[gui_sound] = alias_match_left[gui_sound]
        ## cardinality = 0..1
        alias_name[gui_localization] = alias_match_left[gui_localization]
    }
    ## cardinality = 0..inf
    enum[guiTypes] = {}
    alias_name[gui_standard] = alias_match_left[gui_standard]
    alias_name[gui_animation] = alias_match_left[gui_animation]
    alias_name[gui_sound] = alias_match_left[gui_sound]
    ## cardinality = 0..1
    verticalScrollbar = enum[scrollbar_type]
    ## cardinality = 0..1
    horizontalScrollbar = enum[horizontal_scrollbar_types]
    ## cardinality = 0..1
    autohide_scrollbars = bool
    ## cardinality = 0..1
    drag_scroll = {
        ## cardinality = 0..inf
        enum[dragScrollType]
    }
    ## cardinality = 0..1
    click_to_front = bool
    ###Smoothly scroll a scrollbar -- container version
    ## cardinality = 0..1
    smooth_scrolling = bool
    ##cardinality  = 0..1
    scroll_wheel_factor = float
}
buttonType = {
    name = scalar
    ## cardinality = 0..1
    size = single_alias_right[gui_size_coordinates]
    ## cardinality = 0..1
    borderSize = single_alias_right[gui_size_coordinates]
    alias_name[gui_standard] = alias_match_left[gui_standard]
    alias_name[gui_image] = alias_match_left[gui_image]
    ## cardinality = 0..1
    buttonSpriteType = union[sprite]
    ## cardinality = 0..1
    buttonSprite = union[sprite]
    ## cardinality = 0..1
    hoverSpriteType = union[sprite]
    ## cardinality = 0..1
    hoverSprite = union[sprite]
    ## cardinality = 0..1
    disabledSpriteType = union[sprite]
    ## cardinality = 0..1
    disabledSprite = union[sprite]
    ## cardinality = 0..1
    buttonText = localisation
    ## cardinality = 0..1
    buttonText = localisation_inline
    ## cardinality = 0..1
    buttonFont = value[font_name]
    alias_name[gui_localization] = alias_match_left[gui_localization]
    ## cardinality = 0..inf
    shortcut = scalar
    ## cardinality = 0..1
    hint_tag = localization
    alias_name[gui_sound] = alias_match_left[gui_sound]
    ## cardinality = 0..1
    format = enum[guiTextFormat]
    ## cardinality = 0..1
    multiline = bool
    ## cardinality = 0..1
    font = value[font_name]
    ## cardinality = 0..1
    web_link = scalar
    ## cardinality = 0..1
    no_clicksound = bool
}
dropDownBoxType = {
    name = scalar
    ### Origin of position field
    ## cardinality = 0..1
    orientation = enum[containerOrientation]
    ### Will remove elements outside of size bounding box
    ## cardinality = 0..1
    clipping = bool
    ## cardinality = 0..1
    fullscreen = bool
    ## cardinality = 0..1
    switch_frame_on_expand = bool
    ## cardinality = 0..1
    expandedOnTop = bool
    ## cardinality = 0..inf
    ### Background texture
    background = {
        ## cardinality = 0..1
        name = scalar
        alias_name[gui_standard] = alias_match_left[gui_standard]
        alias_name[gui_image] = alias_match_left[gui_image]
        ## cardinality = 0..1
        alias_name[gui_sound] = alias_match_left[gui_sound]
        ## cardinality = 0..1
        alias_name[gui_localization] = alias_match_left[gui_localization]
    }
    alias_name[gui_standard] = alias_match_left[gui_standard]
    alias_name[gui_animation] = alias_match_left[gui_animation]
    alias_name[gui_sound] = alias_match_left[gui_sound]
    ## cardinality = 0..1
    verticalScrollbar = enum[scrollbar_type]
    ## cardinality = 0..1
    horizontalScrollbar = enum[horizontal_scrollbar_types]
    ## cardinality = 0..1
    autohide_scrollbars = bool
    ## cardinality = 0..1
    drag_scroll = {
        ## cardinality = 0..inf
        enum[dragScrollType]
    }
    ## cardinality = 0..1
    click_to_front = bool
    ## cardinality = 0..1
    ###Smoothly scroll a scrollbar -- container version
    smooth_scrolling = bool
    ##cardinality = 0..1
    scroll_wheel_factor = float
    ##cardinality = 0..1
    expandButton = {
        name = scalar
        ## cardinality = 0..1
        size = single_alias_right[gui_size_coordinates]
        alias_name[gui_standard] = alias_match_left[gui_standard]
        alias_name[gui_image] = alias_match_left[gui_image]
        ## cardinality = 0..1
        buttonText = localisation
        ## cardinality = 0..1
        buttonText = localisation_inline
        ## cardinality = 0..1
        buttonFont = value[font_name]
        ## cardinality = 0..1
        alias_name[gui_localization] = alias_match_left[gui_localization]
        ## cardinality = 0..inf
        shortcut = scalar
        ## cardinality = 0..1
        hint_tag = localization
        alias_name[gui_sound] = alias_match_left[gui_sound]
        ## cardinality = 0..1
        format = enum[guiTextFormat]
        ## cardinality = 0..1
        multiline = bool
        ## cardinality = 0..1
        font = value[font_name]
        ## cardinality = 0..1
        web_link = scalar
    }
    ## cardinality = 0..1
    expandedWindow = {
        name = scalar
        ## cardinality = 0..1
        ### Mouse Draggable
        moveable = bool
        ## cardinality = 0..1
        ### Origin of position field
        orientation = enum[containerOrientation]
        ## cardinality = 0..1
        ### Will remove elements outside of size bounding box
        clipping = bool
        ## cardinality = 0..1
        fullscreen = bool
        ## cardinality = 0..inf
        ### Background texture
        background = {
            ## cardinality = 0..1
            name = scalar
            alias_name[gui_standard] = alias_match_left[gui_standard]
            alias_name[gui_image] = alias_match_left[gui_image]
            ## cardinality = 0..1
            alias_name[gui_sound] = alias_match_left[gui_sound]
            ## cardinality = 0..1
            alias_name[gui_localization] = alias_match_left[gui_localization]
        }

        alias_name[gui_standard] = alias_match_left[gui_standard]
        alias_name[gui_animation] = alias_match_left[gui_animation]
        alias_name[gui_sound] = alias_match_left[gui_sound]
        ## cardinality = 0..1
        verticalScrollbar = enum[scrollbar_type]
        ## cardinality = 0..1
        horizontalScrollbar = enum[horizontal_scrollbar_types]
        ## cardinality = 0..1
        autohide_scrollbars = bool
        ## cardinality = 0..1
        drag_scroll = {
            ## cardinality = 0..inf
            enum[dragScrollType]
        }
        ## cardinality = 0..1
        click_to_front = bool
        ## cardinality = 0..1
        ###Smoothly scroll a scrollbar -- container version
        smooth_scrolling = bool
        ##cardinality  = 0..1
        scroll_wheel_factor = float
    }
}
iconType = {
    ### Name referenced by scripted gui
    name = scalar
    ##cardinality = ~0..1
    alias_name[any_image_type] = alias_match_left[any_image_type]
    alias_name[gui_image] = alias_match_left[gui_image]
    alias_name[gui_standard] = alias_match_left[gui_standard]
    alias_name[gui_localization] = alias_match_left[gui_localization]
}
instantTextBoxType = {
    ### Name referenced by scripted gui
    name = scalar
    ## cardinality = 0..1
    ## cardinality = 0..1
    font = value[font_name]
    ## cardinality = 0..1
    maxWidth = int
    ## cardinality = 0..1
    maxWidth = percentage_field
    ## cardinality = 0..1
    maxHeight = int
    ## cardinality = 0..1
    maxHeight = percentage_field
    ## cardinality = 0..2
    format = enum[guiTextFormat]
    ## cardinality = 0..1
    multiline = bool
    alias_name[gui_standard] = alias_match_left[gui_standard]
    alias_name[gui_localization] = alias_match_left[gui_localization]
    ## cardinality = 0..1
    alwaystransparent = bool
    ## cardinality = 0..1
    #DEBUG
    ### Pixel Border
    borderSize = single_alias_right[gui_size_coordinates]
    ## cardinality = 0..1
    #DEBUG
    ### Missing Description, need testing
    textureFile = union[sprite]
    ## cardinality = 0..1
    #DEBUG
    ### Vertical alignment in text box
    vertical_alignment = enum[guiTextFormatsVertical]
    ## cardinality = 0..1
    #DEBUG
    ### Text box only scroll bar
    scrollbartype = enum[scrollbar_type]
    ## cardinality = 0..1
    fixedsize = bool
    ## cardinality = 0..1
    text_color_code = scalar
    ## cardinality = 0..1
    truncate = bool
}
OverlappingElementsBoxType = {
    ### Name referenced by scripted gui
    name = scalar
    alias_name[gui_standard] = alias_match_left[gui_standard]
    ## cardinality = 0..1
    spacing = float
    ## cardinality = 0..1
    format = enum[guiTextFormat]
    ## cardinality = 0..1
    first_on_top = bool
}
gridBoxType = {
    ### Name referenced by scripted gui
    name = scalar
    name = value_set[gridBoxType_element_name]
    alias_name[gui_standard] = alias_match_left[gui_standard]

    ## cardinality = 0..1
    ### Dimensions of slot, does not clip entries
    slotsize = single_alias_right[gui_size]
    ### Adds entries horizontally
    ## cardinality = 0..1
    add_horizontal = bool
    ## cardinality = 0..1
    ### Maximum number of horizontal slots if adding horizontally
    max_slots_horizontal = int
    ## cardinality = 0..1
    ### Maximum number of vertical slots if adding horizontally
    max_slots_vertical = int
    ## cardinality = 0..1
    ### Maximum number of slots
    max_slots = { x = int y = int }
    ## cardinality = 0..1
    ### Paddding around slots
    padding = {
        ## cardinality = 0..1
        top = int
        ## cardinality = 0..1
        bottom = int
        ## cardinality = 0..1
        left = int
        ## cardinality = 0..1
        right = int
    }
    ## cardinality = 0..1
    format = enum[containerOrientation]
    ## cardinality = 0..1
    background = {
        ## cardinality = 0..1
        name = scalar
        alias_name[gui_standard] = alias_match_left[gui_standard]
        alias_name[gui_image] = alias_match_left[gui_image]
        ## cardinality = 0..1
        alias_name[gui_sound] = alias_match_left[gui_sound]
        ## cardinality = 0..1
        alias_name[gui_localization] = alias_match_left[gui_localization]
    }
}
listBoxType = {
    ### Name referenced by scripted gui
    name = scalar
    alias_name[gui_standard] = alias_match_left[gui_standard]

    ## cardinality = 0..1
    horizontal = int[0..1]
    ## cardinality = 0..1
    spacing = int
    ## cardinality = 0..1
    alwaystransparent = bool
    ## cardinality = 0..1
    scrollbartype = enum[scrollbar_types]
    ## cardinality = 0..1
    borderSize = single_alias_right[gui_size_coordinates]
    ## cardinality = 0..1
    offset = { x = int y = int }
    ## cardinality = 0..1
    backGround = union[sprite]
}
smoothListBoxType = {
    ### Name referenced by scripted gui
    name = scalar
    alias_name[gui_standard] = alias_match_left[gui_standard]

    ## cardinality = 0..1
    horizontal = int[0..1]
    ## cardinality = 0..1
    spacing = int
    ## cardinality = 0..1
    alwaystransparent = bool
    ## cardinality = 0..1
    scrollbartype = enum[scrollbar_types]
    ## cardinality = 0..1
    borderSize = single_alias_right[gui_size_coordinates]
    ## cardinality = 0..1
    offset = { x = int y = int }
    ### Will remove elements outside of size bounding box
    ## cardinality = 0..1
    clipping = bool
    ## cardinality = 0..1
    priority = int
}
positionType = {
    ## cardinality = ~1..1
    name = scalar
    position = single_alias_right[gui_position]
    ## cardinality = 0..1
    scale = float
}
browserType = {
    ### Name referenced by scripted gui
    name = scalar
    ##cardinality = ~1..1
    alias_name[any_image_type] = alias_match_left[any_image_type]
    alias_name[gui_image] = alias_match_left[gui_image]
    alias_name[gui_standard] = alias_match_left[gui_standard]
    alias_name[gui_localization] = alias_match_left[gui_localization]
    ## cardinality = 0..1
    size = single_alias_right[gui_size_coordinates]
}
editBoxType = {
    ### Name referenced by scripted gui
    name = scalar
    ## cardinality = 0..1
    text = localisation
    ## cardinality = 0..1
    text = localisation_inline
    ## cardinality = 0..1
    font = value[font_name]
    ## cardinality = 0..1
    maxWidth = int
    ## cardinality = 0..1
    maxHeight = int
    ## cardinality = 0..2
    format = enum[guiTextFormat]
    ## cardinality = 0..1
    only_numbers = bool
    ## cardinality = 0..1
    multiline = bool
    alias_name[gui_standard] = alias_match_left[gui_standard]
    alias_name[gui_localization] = alias_match_left[gui_localization]
    ## cardinality = 0..1
    alwaystransparent = bool
    ## cardinality = 0..1
    #DEBUG
    ### Pixel Border
    borderSize = single_alias_right[gui_size_coordinates]
    ## cardinality = 0..1
    #DEBUG
    ### Missing Descriptiion, need testing
    textureFile = union[sprite]
    ## cardinality = 0..1
    textureFile = filepath
    ## cardinality = 0..1
    #DEBUG
    ### Vertical alignement in text box
    vertical_alignment = enum[guiTextFormatsVertical]
    ## cardinality = 0..1
    #DEBUG
    ### Text box only scroll bar
    scrollbartype = enum[scrollbar_type]
    ## cardinality = 0..1
    fixedsize = bool
    ## cardinality = 0..1
    text_color_code = scalar
    ## cardinality = 0..1
    truncate = bool
    ## cardinality = 0..1
    instantTextBoxType = bool
    ## cardinality = 0..1
    use_special_chars = bool
    ## cardinality = 0..1
    cursor = { x = int y = int }
    ## cardinality = 0..1
    is_multiline = bool
    ## cardinality = 0..1
    ignore_enter = bool
}
checkboxType = {
    name = scalar
    ## cardinality = 0..1
    buttonText = localisation
    ## cardinality = 0..1
    buttonText = localisation_inline
    ## cardinality = 0..1
    buttonFont = value[font_name]
    alias_name[gui_standard] = alias_match_left[gui_standard]
    alias_name[gui_image] = alias_match_left[gui_image]
    alias_name[gui_sound] = alias_match_left[gui_sound]
    alias_name[gui_localization] = alias_match_left[gui_localization]
}
scrollbarType = {
    name = scalar
    slider = scalar
    track = scalar
    leftbutton = scalar
    rightbutton = scalar
    size = single_alias_right[gui_size_coordinates]
    position = single_alias_right[gui_position]
    priority = int
    borderSize = single_alias_right[gui_size_coordinates]
    maxValue = float
    minValue = float
    stepSize = float
    startValue = float
    horizontal = float
    ## cardinality = 4..4
    guiButtonType = {
        name = scalar
        quadTextureSprite = union[sprite]
        ## cardinality = 0..1
        spriteType = union[sprite]
        ## cardinality = 0..1
        buttonSpriteType = union[sprite]
        ## cardinality = 0..1
        hoverSpriteType = union[sprite]
        ## cardinality = 0..1
        disabledSpriteType = union[sprite]
        position = single_alias_right[gui_position]
        ## cardinality = 0..1
        clicksound = <soundeffect>
        ## cardinality = 0..1
        clicksound = click
        ## cardinality = 0..1
        parent = union[guiType]
    }
}
extendedScrollbarType = {
    name = scalar
    alias_name[gui_standard] = alias_match_left[gui_standard]

    ## cardinality = 0..1
    background = {
        ## cardinality = 0..1
        name = scalar
        alias_name[gui_standard] = alias_match_left[gui_standard]
        alias_name[gui_image] = alias_match_left[gui_image]
        ## cardinality = 0..1
        alias_name[gui_sound] = alias_match_left[gui_sound]
        ## cardinality = 0..1
        alias_name[gui_localization] = alias_match_left[gui_localization]
    }
    ##cardinality  = 0..1
    ###Size in px of tiling
    tileSize = single_alias_right[gui_size]
    ##cardinality  = 0..1
    ###Maximum value of slider
    maxValue = float
    ##cardinality  = 0..1
    ###Minimum value of slider
    minValue = float
    ##cardinality  = 0..1
    ###Start position of slider
    startValue = float
    ##cardinality  = 0..1
    ###Size of slider increment
    stepSize = float
    ##cardinality  = 0..1
    ###Horizontal or vertical slider
    horizontal = bool
    ##cardinality  = 0..1
    ###Smoothing percentage (reduces steps)
    smooth_scrolling = float
    ##cardinality  = 0..1
    clickonly = bool
    ##cardinality = 0..1
    setTrackFrameOnChange = bool
    ##cardinality  = 1..1
    slider = {
        name = scalar
        alias_name[gui_image] = alias_match_left[gui_image]
        position = single_alias_right[gui_position]
        alias_name[gui_localization] = alias_match_left[gui_localization]
    }
    ##cardinality  = 1..1
    track = {
        name = scalar
        alias_name[gui_image] = alias_match_left[gui_image]
        position = single_alias_right[gui_position]
        alias_name[gui_localization] = alias_match_left[gui_localization]
    }
    ##cardinality  = 0..1
    increaseButton = {
        name = scalar
        alias_name[gui_image] = alias_match_left[gui_image]
        alias_name[gui_sound] = alias_match_left[gui_sound]
        position = single_alias_right[gui_position]
        alias_name[gui_localization] = alias_match_left[gui_localization]
    }
    ##cardinality  = 0..1
    decreaseButton = {
        name = scalar
        alias_name[gui_image] = alias_match_left[gui_image]
        alias_name[gui_sound] = alias_match_left[gui_sound]
        position = single_alias_right[gui_position]
        alias_name[gui_localization] = alias_match_left[gui_localization]
    }
    ##cardinality  = 0..1
}
#GUI Standard Functions
### Position of element. Absolute in px, % of screen, or % of parent.
single_alias[gui_position] = {
    ## cardinality = 0..1
    x = float
    ## cardinality = 0..1
    x = percentage_field
    ## cardinality = 0..1
    y = float
    ## cardinality = 0..1
    y = percentage_field
}
### Position of element. Absolute in px, % of screen, or % of parent.
alias[gui_standard:position] = single_alias_right[gui_position]
###Size of element. Absolute in px, % of screen, or % of parent.
single_alias[gui_size] = {
    ## cardinality = 0..1
    width = int
    ## cardinality = 0..1
    width = percentage_field
    ## cardinality = 0..1
    height = int
    ## cardinality = 0..1
    height = percentage_field
    ## cardinality = 0..1
    min = {
        ## cardinality = 0..1
        width = int
        ## cardinality = 0..1
        width = percentage_field
        ## cardinality = 0..1
        height = int
        ## cardinality = 0..1
        height = percentage_field
    }
    ## cardinality = 0..1
    max = {
        ## cardinality = 0..1
        width = int
        ## cardinality = 0..1
        width = percentage_field
        ## cardinality = 0..1
        height = int
        ## cardinality = 0..1
        height = percentage_field
    }
    ## cardinality = 0..1
    preserve_aspect_ratio = bool
}
single_alias[gui_size_coordinates] = {
    ## cardinality = 0..1
    x = float
    ## cardinality = 0..1
    x = percentage_field
    ## cardinality = 0..1
    y = float
    ## cardinality = 0..1
    y = percentage_field
}
###Size of element. Absolute in px, % of screen, or % of parent.
alias[gui_standard:size] = single_alias_right[gui_size]
alias[gui_standard:margin] = {
    ## cardinality = 0..1
    top = int
    ## cardinality = 0..1
    bottom = int
    ## cardinality = 0..1
    left = int
    ## cardinality = 0..1
    right = int
}
alias[gui_standard:background_margin] = {
    ## cardinality = 0..1
    top = int
    ## cardinality = 0..1
    bottom = int
    ## cardinality = 0..1
    left = int
    ## cardinality = 0..1
    right = int
}
