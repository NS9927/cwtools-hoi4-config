    complex_enum[horizontal_scrollbar_type] = {
        path = "game/interface"
        name = {
            extendedScrollbarType = {
                name = enum_name
                horizontal = yes
            }
            scrollbarType = {
                name = enum_name
                horizontal = yes
            }
        }
    }
    complex_enum[scrollbar_type] = {
        path = "game/interface"
        name = {
            extendedScrollbarType = {
                name = enum_name
            }
            scrollbarType = {
                name = enum_name
            }
        }
    }
