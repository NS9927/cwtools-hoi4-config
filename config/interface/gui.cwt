    alias_name[gui_image:buttonSpriteType] = alias_match_left[gui_image:buttonSpriteType]
    alias_name[gui_image:buttonSprite] = alias_match_left[gui_image:buttonSprite]
    alias_name[gui_image:hoverSpriteType] = alias_match_left[gui_image:hoverSpriteType]
    alias_name[gui_image:hoverSprite] = alias_match_left[gui_image:hoverSprite]
    alias_name[gui_image:disabledSpriteType] = alias_match_left[gui_image:disabledSpriteType]
    alias_name[gui_image:disabledSprite] = alias_match_left[gui_image:disabledSprite]
    alias_name[gui_image:backGround] = alias_match_left[gui_image:backGround]
    alias_name[gui_image:textureFile] = alias_match_left[gui_image:textureFile]
    alias_name[gui_image:textureFile1] = alias_match_left[gui_image:textureFile1]
    alias_name[gui_image:textureFile2] = alias_match_left[gui_image:textureFile2]
}
