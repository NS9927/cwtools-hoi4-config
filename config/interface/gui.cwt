alias[gui_image:textureFile] = union[sprite]
alias[gui_image:textureFile1] = union[sprite]
alias[gui_image:textureFile2] = union[sprite]
### Image Sprite
single_alias[gui_image:any_image_type] = {
    alias_name[gui_image:spriteType] = alias_match_left[gui_image:spriteType]
