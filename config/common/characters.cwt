types = {
	## unique = yes
	type[character] = {
		path = "game/common/characters"
		path_strict = yes
		skip_root_key = any
        name_field = $
        localisation = {
            name = name
        }
		subtype[instanced] = {
			## cardinality = ~1..inf
			instance = {}
		}
		subtype[uninstanced] = {}
		subtype[country_leader] = {
			## cardinality = 1..inf
			country_leader = {}
		}
		subtype[country_leader] = {
			## cardinality = ~1..inf
			instance = {
				## cardinality = 1..inf
				country_leader = {}
			}
		}
		subtype[corps_commander] = {
			corps_commander = {}
        }
		subtype[corps_commander] = {
			## cardinality = ~1..inf
			instance = {
				corps_commander = {}
			}
        }
		subtype[field_marshal] = {
			field_marshal = {}
		}
		subtype[field_marshal] = {
			## cardinality = ~1..inf
			instance = {
				field_marshal = {}
			}
		}
		subtype[navy_leader] = {
			navy_leader = {}
		}
		subtype[navy_leader] = {
			## cardinality = ~1..inf
			instance = {
				navy_leader = {}
			}
		}
		subtype[advisor] = {
			## cardinality = 1..inf
			advisor = {}
		}
		subtype[scientist] = {
			## cardinality = 1..inf
			scientist = {}
		}
		subtype[advisor] = {
			## cardinality = ~1..inf
			instance = {
				## cardinality = 1..inf
				advisor = {}
			}
		}
	}
}

character = {
    name = localisation
    gender = enum[gender]
    ## cardinality = 0..1
    portraits = single_alias_right[portraits_sprite]
	subtype[uninstanced] = {
		## cardinality = 0..1
		## replace_scope = { this = any root = country }
		allowed_civil_war = {
			alias_name[trigger] = alias_match_left[trigger]
		}
		## cardinality = 0..1
		name = localisation_inline
		## cardinality = 0..1
		can_be_captured = bool
		## cardinality = 0..1
		gender = female
		## cardinality = 0..1
		gender = male
		## cardinality = 0..1
		gender = undefined
	}
	subtype[country_leader] = {
		country_leader = single_alias_right[country_leader]
	}
	subtype[corps_commander] = {
		corps_commander = single_alias_right[corps_commander]
	}
	subtype[field_marshal] = {
		field_marshal = single_alias_right[field_marshal]
	}
	subtype[navy_leader] = {
		navy_leader = single_alias_right[navy_leader]
	}
	subtype[advisor] = {
		advisor = single_alias_right[advisor]
	}
	subtype[scientist] = {
		scientist = single_alias_right[scientist]
	}
	subtype[instanced] = {
		### Character instance, for use on startup checks (i.e. has_dlc, and similar) to create alternate versions of a character, usually two
		## cardinality = ~0..inf
		instance = {
            portraits = single_alias_right[portraits_sprite]
			## replace_scope = { this = any root = country }
			allowed = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			### Should have at least one portrait defined
			## cardinality = 0..1
			name = localisation_inline
			## cardinality = 0..1
			can_be_captured = bool
			## cardinality = 0..1
			gender = female
			## cardinality = 0..1
			gender = male
			## cardinality = 0..1
			gender = undefined
			## cardinality = 0..1
			## replace_scope = { this = any root = country }
			allowed_civil_war = {
				alias_name[trigger] = alias_match_left[trigger]
			}
			### Country leader subtype
			## cardinality = 0..inf
			country_leader = single_alias_right[country_leader]
			### Corps commander subtype
			## cardinality = 0..1
			corps_commander = single_alias_right[corps_commander]
			### Field marshal subtype
			## cardinality = 0..1
			field_marshal = single_alias_right[field_marshal]
			### Navy leader subtype
			## cardinality = 0..1
			navy_leader = single_alias_right[navy_leader]
			### Advisor subtype
			## cardinality = 0..inf
			advisor = single_alias_right[advisor]
			### Scientist subtype
			## cardinality = 0..inf
			scientist = single_alias_right[scientist]
		}
	}
}

enums = {
	enum[character_ids] = {
		id
		legacy_id
	}
	enum[character_portrait_types] = {
		civilian
		army
		navy
		operative
	}
	enum[character_roles] = {
		country_leader
		navy_leader
		corps_commander
		field_marshal
		scientist
		advisor
	}
}

single_alias[country_leader] = {
    ideology = <sub_ideology>
    ## cardinality = 0..1
    desc = localisation
    ## cardinality = 0..1
    expire = date_field[y.m.d.h]
    ## cardinality = 0..1
    name = localisation
    ### Sets starting traits for this leader.
    ## cardinality = 0..1
    traits = {
        ## cardinality = 0..inf
        <country_leader_trait>
    }
    ## cardinality = 0..1
    research_bonus = {
        ## cardinality = 1..inf
        enum[tech_category] = float
    }
    ## cardinality = 0..1
    enum[character_ids] = value_set[country_leader_ids]
    ## cardinality = 0..1
    enum[character_ids] = -1
}
single_alias[corps_commander] = {
    ## cardinality = 0..1
    desc = localisation
    ## cardinality = 0..1
    expire = datetime_field
    ## cardinality = ~1..1
    skill = int
    ## cardinality = ~1..1
    attack_skill = int
    ## cardinality = ~1..1
    defense_skill = int
    ## cardinality = ~1..1
    planning_skill = int
    ## cardinality = ~1..1
    logistics_skill = int
    ## cardinality = 0..1
    enum[character_ids] = value_set[unit_leader_ids]
    ## cardinality = 0..1
    enum[character_ids] = -1
    ## cardinality = 0..1
    name = localisation
    ### Sets starting traits for this leader.
    ## cardinality = 0..1
    traits = {
        ## cardinality = 0..inf
        <unit_leader_trait>
    }
    ### Can the player see this character as a unit leader.
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    visible = {
        alias_name[trigger] = alias_match_left[trigger]
    }
}
single_alias[field_marshal] = {
    ## cardinality = 0..1
    desc = localisation
    ## cardinality = 0..1
    expire = datetime_field
    ## cardinality = ~1..1
    skill = int
    ## cardinality = ~1..1
    attack_skill = int
    ## cardinality = ~1..1
    defense_skill = int
    ## cardinality = ~1..1
    planning_skill = int
    ## cardinality = ~1..1
    logistics_skill = int
    ## cardinality = 0..1
    enum[character_ids] = value_set[unit_leader_ids]
    ## cardinality = 0..1
    enum[character_ids] = -1
    ### Sets starting traits for this leader.
    ## cardinality = 0..1
    traits = {
        ## cardinality = 0..inf
        <unit_leader_trait>
    }
    ### Can the player see this character as a unit leader.
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    visible = {
        alias_name[trigger] = alias_match_left[trigger]
    }
}
single_alias[navy_leader] = {
    ## cardinality = 0..1
    desc = localisation
    ## cardinality = 0..1
    expire = datetime_field
    ## cardinality = ~1..1
    skill = int
    ## cardinality = ~1..1
    attack_skill = int
    ## cardinality = ~1..1
    defense_skill = int
    ## cardinality = ~1..1
    maneuvering_skill = int
    ## cardinality = ~1..1
    coordination_skill = int
    ## cardinality = 0..1
    enum[character_ids] = value_set[unit_leader_ids]
    ## cardinality = 0..1
    enum[character_ids] = -1
    ## cardinality = 0..1
    name = localisation
    ### Sets starting traits for this leader.
    ## cardinality = 0..1
    traits = {
        ## cardinality = 0..inf
        <unit_leader_trait>
    }
    ### Can the player see this character as a unit leader.
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    visible = {
        alias_name[trigger] = alias_match_left[trigger]
    }
}
single_alias[advisor] = {
    slot = value[character_advisor_slot]
    ## cardinality = 0..1
    name = localisation
    ## cardinality = 0..1
    desc = localisation
    ### Optional, defaults to <character>_advisor_role
    ## cardinality = 0..1
    idea_token = value_set[advisor_token]
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    allowed = {
        alias_name[trigger] = alias_match_left[trigger]
    }
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    visible = {
        alias_name[trigger] = alias_match_left[trigger]
    }
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    available = {
        alias_name[trigger] = alias_match_left[trigger]
    }
    ## cardinality = 0..1
    name = localisation
    ### Sets advsior effects.
    ## cardinality = ~1..1
    traits = {
        ## cardinality = 0..inf
        <country_leader_trait>
    }
    ## cardinality = 0..1
    research_bonus = {
        ## cardinality = 1..inf
        enum[tech_category] = float
    }
    ## cardinality = 0..1
    ledger = enum[ledgers]
    ### overrides default cost of advisor
    ## cardinality = 0..1
    cost = int
    ### cost to remove advisor, -1 prevents removal
    ## cardinality = 0..1
    removal_cost = int
    ## cardinality = 0..1
    ## replace_scope = { this = any root = country }
    ai_will_do = {
        enum[base_factor] = variable_field
        alias_name[modifier_rule] = alias_match_left[modifier_rule]
    }
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..inf
    on_add = {
        alias_name[effect] = alias_match_left[effect]
    }
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..inf
    on_remove = {
        alias_name[effect] = alias_match_left[effect]
    }
    ### While it is used in vanilla and doesn't throw errors, I can't get it to work reliably so I suspect there is some hard-coded strangeness going on here.
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    do_effect = {
        alias_name[trigger] = alias_match_left[trigger]
    }
    ### Modifiers that are applied to tag while the advisor is active.
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    modifier = {
        alias_name[modifier] = alias_match_left[modifier]
    }
    ## cardinality = 0..1
    can_be_fired = bool
}
single_alias[scientist] = {
    ## cardinality = 0..1
    desc = localisation
    ## replace_scope = { this = any root = country }
    ## cardinality = 0..1
    visible = {
        alias_name[trigger] = alias_match_left[trigger]
    }
    ## cardinality = 0..1
    traits = {
        ## cardinality = ~1..inf
        <scientist_trait>
    }
    ## cardinality = 1..1
    skills = {
        ## cardinality = 1..1
        <specialization> = int
    }
}

single_alias[portraits_sprite] = {
    ## cardinality = 0..1
    civilian = single_alias_right[portraits_sprite_size]
    ## cardinality = 0..1
    army = single_alias_right[portraits_sprite_size]
    ## cardinality = 0..1
    navy = single_alias_right[portraits_sprite_size]
    ## cardinality = 0..1
    operative = single_alias_right[portraits_sprite_size]
}
single_alias[portraits_sprite_size] = {
    ## cardinality = 0..1
    large = union[sprite]
    ## cardinality = 0..1
    small = union[sprite]
}